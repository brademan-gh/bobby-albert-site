---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Bobby Albert's blog posts and resources, preserved and available to read." } = Astro.props;
const siteTitle = 'Bobby Albert';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title} | {siteTitle}</title>

    <!-- Open Graph / social + AI-agent readability -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">{siteTitle}</a>
        <a href="/blog/">Blog</a>
        <a href="/resources/">Resources</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Bobby Albert. All rights reserved. Site code available under the MIT License.</p>
    </footer>
  </body>
</html>
