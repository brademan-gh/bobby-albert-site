---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BobbyPortrait from '../assets/bobby-albert-portrait.jpg';

// A hand-picked front door into the blog. Showing the newest five was
// misleading: the two most recent are a Christmas devotional and a video
// announcement, neither of which represents Bobby's leadership writing.
// Edit this list to change what appears; order here is order shown.
const START_HERE = [
	'what-is-culture',
	'how-to-discover-your-core-values-create-extraordinary-results',
	'whats-more-important-managing-or-leading',
	'360-degree-evaluation-changed-leadership',
	'recognize-6-consequences-poor-leadership',
	'new-way-lead',
];

const all = await getCollection('blog', ({ data }) => !data.draft);
const byId = new Map(all.map((p) => [p.id, p]));
const posts = START_HERE.map((id) => byId.get(id)).filter((p) => p !== undefined);
if (posts.length !== START_HERE.length) {
	throw new Error(
		'START_HERE lists a slug with no matching post: ' +
			START_HERE.filter((id) => !byId.has(id)).join(', '),
	);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				overflow: hidden; /* contain the float so "Recent posts" clears it */
			}
			.portrait {
				display: block;
				float: right;
				width: 220px;
				height: auto;
				margin: 0 0 1em 1.5em;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.start-note {
				margin: -0.25em 0 0.75em 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			@media (max-width: 720px) {
				.portrait {
					float: none;
					width: 180px;
					margin: 0 auto 1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="intro">
				<Image
					class="portrait"
					src={BobbyPortrait}
					width={440}
					height={440}
					alt="Bobby Albert seated in an armchair, smiling and looking off camera."
				/>
				<h1>Bobby Albert</h1>
				<p>
					Bobby Albert spent more than 40 years in business and arrived at one conviction:
				</p>
				<blockquote>
					<p><strong>I want to be a Values-Driven company that achieves results; not a Results-Driven company that has values.</strong></p>
				</blockquote>
				<p>
					He lived it out — growing a five-employee company into a 150-person organization.
					When he focused on people instead of profits, the profits followed.
				</p>
				<p>
					Here he writes about leadership and workplace culture &mdash; how you lead, the
					culture it creates, and how the two together decide what your business can
					become. You&rsquo;ll also find the True North Business guides he built to help
					other leaders do the same.
				</p>
			</div>

			<h2>Start here</h2>
			<p class="start-note">New to Bobby&rsquo;s writing? These are good places to begin.</p>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</li>
					))
				}
			</ul>
			<p><a href="/blog/">See all posts &rarr;</a></p>
			<p><a href="/resources/">Browse resources &rarr;</a></p>
		</main>
		<Footer />
	</body>
</html>
