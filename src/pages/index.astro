---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf())
  .slice(0, 5);
---
<Layout title="Home">
  <h1>Bobby Albert</h1>
  <p>
    A preserved collection of Bobby Albert's blog posts and PDF resources —
    kept available for anyone looking for his writing.
  </p>

  <h2>Recent posts</h2>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
  <p><a href="/blog/">See all posts &rarr;</a></p>

  <p><a href="/resources/">Browse resources &rarr;</a></p>
</Layout>
