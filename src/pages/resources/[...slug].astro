---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('resources', ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
// Slug/filename convention: public/pdfs/<slug>.pdf must match this entry's id.
const pdfHref = `/pdfs/${item.id}.pdf`;
---
<Layout title={item.data.title} description={item.data.description}>
  <article>
    <h1>{item.data.title}</h1>
    <p><a href={pdfHref} download>Download the original PDF &darr;</a></p>
    <Content />
    <p><a href={pdfHref} download>Download the original PDF &darr;</a></p>
  </article>
</Layout>
