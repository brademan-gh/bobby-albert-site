---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Resource from '../../layouts/Resource.astro';

export async function getStaticPaths() {
	const items = await getCollection('resources', ({ data }) => !data.draft);
	return items.map((item) => ({
		params: { slug: item.id },
		props: item,
	}));
}
type Props = CollectionEntry<'resources'>;

const item = Astro.props;
const { Content } = await render(item);
// Slug/filename convention: public/pdfs/<slug>.pdf must match this entry's id.
const pdfHref = `/pdfs/${item.id}.pdf`;
---

<Resource {...item.data} pdfHref={pdfHref}>
	<Content />
</Resource>
