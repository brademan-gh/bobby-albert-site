---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const CATEGORY = 'True North Business';

const items = (
	await getCollection('resources', ({ data }) => !data.draft && data.category === CATEGORY)
).sort((a, b) => a.data.title.localeCompare(b.data.title));

const pageTitle = `True North Business | ${SITE_TITLE}`;
const description =
	"Bobby Albert's True North Business guides and worksheets — core values, purpose, vision, super-objectives and the practices that connect them. Read each one here, or download the original PDF.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={description} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			li {
				padding: 1em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			li a {
				text-decoration: none;
				color: rgb(var(--black));
				font-weight: 700;
			}
			li a:hover {
				color: var(--accent);
			}
			li p {
				margin: 0.25em 0 0 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.back {
				font-size: 0.9em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>True North Business</h1>
			<p>{description}</p>
			<ul>
				{
					items.map((item) => (
						<li>
							<a href={`/resources/${item.id}/`}>{item.data.title}</a>
							{item.data.description && <p>{item.data.description}</p>}
						</li>
					))
				}
			</ul>
			<p class="back"><a href="/resources/">&larr; All resources</a></p>
		</main>
		<Footer />
	</body>
</html>
