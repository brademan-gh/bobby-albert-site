---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf());
---
<Layout title="Blog" description="All of Bobby Albert's preserved blog posts.">
  <h1>Blog</h1>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        {' — '}
        <time datetime={post.data.datePublished.toISOString()}>
          {post.data.datePublished.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </li>
    ))}
  </ul>
</Layout>
